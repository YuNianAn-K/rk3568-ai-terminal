#!/bin/sh
#
# AI Voice Terminal - startup script
#

DAEMON="python3"
OPTS="-u /root/AI_voice/voice_service.py"
PIDFILE="/var/run/ai-voice.pid"
LOGFILE="/var/log/ai-voice.log"
export PYTHONPATH=/root/AI_voice
# Non-secret opt-in marker; absence preserves the original button-only boot.
if [ -f /root/AI_voice/config/wake.enabled ]; then
    : "${VOICE_WAKE_ENABLE:=1}"
    export VOICE_WAKE_ENABLE
fi

is_running() {
    [ -f "$PIDFILE" ] || return 1
    PID=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null
}

start() {
    if is_running; then
        echo "AI Voice Terminal is already running (PID $PID)"
        return 0
    fi
    rm -f "$PIDFILE"
    echo "Starting AI Voice Service..."
    cd /root/AI_voice || return 1
    $DAEMON $OPTS >> "$LOGFILE" 2>&1 &
    echo $! > $PIDFILE
    sleep 2
    if is_running; then
        echo "Started (PID $PID)"
        return 0
    fi
    echo "Start failed; see $LOGFILE"
    rm -f "$PIDFILE"
    return 1
}

stop() {
    if is_running; then
        echo "Stopping AI Voice Terminal (PID $PID)..."
        kill "$PID" 2>/dev/null
        COUNT=0
        while kill -0 "$PID" 2>/dev/null && [ "$COUNT" -lt 5 ]; do
            sleep 1
            COUNT=$((COUNT + 1))
        done
        if kill -0 "$PID" 2>/dev/null; then
            kill -9 "$PID" 2>/dev/null
        fi
        rm -f "$PIDFILE"
        echo "Stopped"
    elif [ -f "$PIDFILE" ]; then
        echo "Removing stale PID file"
        rm -f "$PIDFILE"
    else
        echo "Not running"
    fi
}

status() {
    if is_running; then
        echo "Running (PID $PID)"
        return 0
    fi
    echo "Not running"
    return 1
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

exit $?
